# ==============================================================================
# VENUELUXE ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and insert your real API keys:
#   cp .env.example .env
# ==============================================================================

# Application Meta
VITE_APP_TITLE=VenueLuxe

# ------------------------------------------------------------------------------
# MAP & GEOCODING APIS
# ------------------------------------------------------------------------------
# Options: osm | mapbox | locationiq
# (Default is 'osm' which is 100% free and requires NO api key)
VITE_MAP_PROVIDER=osm

# ------------------------------------------------------------------------------
# 1. OpenStreetMap & Nominatim (100% FREE - No API Key or Credit Card Required)
# ------------------------------------------------------------------------------
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# ------------------------------------------------------------------------------
# 2. Mapbox GL JS (50,000 Free Map Loads/Month + High-Res Vector Styling)
# ------------------------------------------------------------------------------
# Get your free token at: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_public_access_token_here

# ------------------------------------------------------------------------------
# 3. LocationIQ (5,000 Free Requests/Day for Geocoding & Address Autocomplete)
# ------------------------------------------------------------------------------
# Get your free token at: https://my.locationiq.com/dashboard#accesstoken
VITE_LOCATIONIQ_API_KEY=your_locationiq_token_here
