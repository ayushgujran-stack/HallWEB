# VenueLuxe Environment Configuration Example
# Copy or reference these values in js/config.js or localStorage

# --- 1. ElevenLabs High-Fidelity AI Voice (Tier 1) ---
# Sign up at https://elevenlabs.io
# Fallback Cascade: ElevenLabs -> OpenRouter -> WebSpeech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- 2. OpenRouter Free AI API Key (Tier 2 & NLU) ---
# Register 100% free at https://openrouter.ai/keys (No credit card needed)
OPENROUTER_API_KEY=

# Default Free OpenRouter Model
# Options:
# - meta-llama/llama-3.3-70b-instruct:free (Recommended)
# - deepseek/deepseek-r1:free
# - google/gemini-2.0-flash-exp:free
# - mistralai/mistral-small-24b-instruct-2501:free
# - qwen/qwen-2.5-72b-instruct:free
DEFAULT_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Natural Language Engine: openrouter | builtin | gemini | groq
DEFAULT_NLP_ENGINE=openrouter

# Speech-to-Text: webspeech | whisper
DEFAULT_STT_ENGINE=webspeech
